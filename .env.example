# ============================================================
#  Tock Reservation Bot — Environment Variables
#  Copy this file to .env and fill in real values.
#  NEVER commit .env to git.
# ============================================================

# --- Tock account credentials ---
TOCK_EMAIL=your_email@example.com
TOCK_PASSWORD=your_password_here

# --- Notifications ---
# Discord webhook URL for booking alerts, sniper mode, errors, etc.
# Create one: Server Settings → Integrations → Webhooks → New Webhook
# Leave blank to disable Discord notifications (console logs always work).
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/YOUR_ID/YOUR_TOKEN

# --- Browser mode ---
# true  = headless (runs silently in background, recommended for production)
# false = headed  (browser window visible, good for debugging / first run)
HEADLESS=false

# --- Dry-run mode ---
# true  = full flow (login → detect → select slot) but stops before confirming
# false = actually book the reservation
DRY_RUN=false

# --- Restaurant ---
RESTAURANT_SLUG=fui-hui-hua-san-francisco

# --- Booking preferences ---
PARTY_SIZE=2
PREFERRED_DAYS=Friday,Saturday,Sunday
PREFERRED_TIME=17:00      	# 24-hour format; "17:00" = 5 PM
SCAN_WEEKS=2              	# how many weeks ahead to scan
SCAN_WEEKS_LOOKAHEAD=0		# how many weeks to skip

# Fallback days (booked only if no preferred_days slots found).
# Setting fallback days ALSO enables prewarm coverage for those weekdays.
#
# Fuhuihua-specific: the restaurant is closed Mon/Tue, so only Wed/Thu are
# meaningful weekday targets. A single Friday release covers next week's
# Wed/Thu/Fri/Sat/Sun — Wed/Thu BEFORE the targeted Friday, not after
# (after = two weeks out, not in this release).
#
# Recommended: leave empty for the first observation window so the first
# run prewarms only the 3 weekend dates (low CF risk). After confirming
# clean behavior on a real release window, opt in to weekday prewarm:
#   FALLBACK_DAYS=Wednesday,Thursday
FALLBACK_DAYS=

# --- Normal release window (moderate aggressive polling @ 60s) ---
# Use SNIPER mode for ultra-fast polling (see below).
RELEASE_WINDOW_DAYS=Monday
RELEASE_WINDOW_START=09:00
RELEASE_WINDOW_END=11:00

# --- Sniper mode (polls every ~3 seconds around known release times) ---
# Days to enter sniper mode (comma-separated, full English weekday names)
SNIPER_DAYS=Wednesday,Friday
# Start times (PT, 24-hour) to enter sniper mode — bot monitors from each time
# for SNIPER_DURATION_MIN minutes. Comma-separated; supports multiple windows.
# e.g. "16:59,19:59" covers both 5pm and 8pm PT release windows.
SNIPER_TIMES=16:59,19:59
# How many minutes each sniper window lasts (default: 11 minutes past start)
SNIPER_DURATION_MIN=11
# Sleep interval between polls during sniper mode (seconds, default: 3)
SNIPER_INTERVAL_SEC=3
# Cap scan range during sniper window — Tock releases ≤2 weeks of slots at a time.
# Smaller = less wasted scanning + lower Cloudflare exposure during release.
SNIPER_SCAN_WEEKS=2

# Prewarm skip horizon: how many days from today to start prewarm targets.
# Fuhuihua's Friday release covers next-week dates (T+5 to T+9), so the
# default is 5. If your restaurant releases on a different cadence, adjust
# this so prewarm targets the dates the upcoming release will cover.
# Setting too low wastes prewarm slots on prior-release dates; too high
# misses the actual targets.
PREWARM_MIN_DAYS_OUT=5
